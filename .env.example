# Скопируйте в .env и отредактируйте: cp .env.example .env
# Файл .env в git не попадает.

# --- Сервер ---
SERVER_NAME=Custom Mechanics Server
LEVEL_NAME=Bedrock level
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=true
MAX_PLAYERS=6
ONLINE_MODE=true
ALLOW_LIST=false

# Версия BDS. LATEST — свежая стабильная. Должна поддерживать версии модулей
# из addon/manifest.json (@minecraft/server 2.9.0), иначе пак не загрузится.
BDS_VERSION=LATEST

# --- Производительность (значения подобраны под 1 vCPU / 2 GiB) ---
VIEW_DISTANCE=10
TICK_DISTANCE=4
PLAYER_IDLE_TIMEOUT=0
MEM_LIMIT=1500m

# --- Права ---
# Xbox-геймертеги операторов через запятую: OPS=Gamertag1,Gamertag2
OPS=
DEFAULT_PLAYER_PERMISSION_LEVEL=member

# --- Сеть ---
# Хост-порт BDS. Значения разные на двух фазах:
#   • Фаза 1 (Mac + Phantom): 19133. Phantom обязан сам занять 19132, иначе он
#     не получит broadcast-запросы консолей, и контейнер BDS на 19132 просто
#     не поднимется — Docker скажет "port is already allocated".
#   • Фаза 2 (VPS, Phantom не запускается): 19132.
SERVER_PORT=19133
SERVER_PORT_V6=19134

# --- Инструменты ---
# Каталог данных сервера на хосте (используется tools/activate-pack.mjs).
SERVER_DATA_DIR=./server-data
# Адрес сервера для Phantom (только PlayStation — Switch ходит мимо Phantom,
# см. README, раздел «Nintendo Switch»).
# Фаза 1: 127.0.0.1:19133 — тот же порт, что SERVER_PORT выше.
# Фаза 2: <IP_ДРОПЛЕТА>:19132
PHANTOM_SERVER=127.0.0.1:19133
